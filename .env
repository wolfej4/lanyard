# Lanyard sample environment: a filled-in production example.
#
# 1. Copy to .env:  cp .env.sample .env
# 2. Replace every CHANGE_ME (the app refuses to start while any remain).
# 3. Swap the example domain, email and names for your own.
# 4. docker compose up -d
#
# .env.example has the same settings with longer explanations.

# ---- Site ---------------------------------------------------------------------
SITE_NAME=Lanyard
BASE_URL=https://lan.wolfe.house
TZ=America/Chicago

# ---- Secrets ------------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---- People -------------------------------------------------------------------
# Signs in to /admin. Comma-separate several.
ADMIN_EMAILS=jacob@wolfe.house

# ---- Legal pages --------------------------------------------------------------
OPERATOR_NAME=SwyfTech LLC
CONTACT_EMAIL=support@wolfe.house
GOVERNING_LAW=Florida
LEGAL_UPDATED=October 4, 2026
MIN_AGE=13

# ---- Email (Resend shown; any transactional SMTP provider works) ---------------
# Postmark:  SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587  SMTP_USER/PASSWORD = server API token
# Amazon SES: SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_PORT=587  SMTP credentials from SES
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME_resend_api_key
SMTP_STARTTLS=true
SMTP_SSL=false
# Must be on a domain verified with your provider (SPF + DKIM).
MAIL_FROM=Lanyard <noreply@lan.wolfe.house>

# ---- Payments (Stripe test mode) ----------------------------------------------
# Start with test keys. Switch to sk_live_ and the live webhook secret only after
# a full test purchase and refund works end to end.
# To run free events only, leave both Stripe values empty.
STRIPE_SECRET_KEY=CHANGE_ME_sk_test_from_stripe_dashboard
# From the webhook endpoint at https://lan.wolfe.house/stripe/webhook
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_from_stripe_webhook
CURRENCY=usd
PLATFORM_FEE_PERCENT=0
DEV_FAKE_PAYMENTS=false

# ---- Limits -------------------------------------------------------------------
FREE_CAPACITY_LIMIT=20
MAX_CAPACITY=2000

# ---- Deployment (Unraid / Dockhand) -------------------------------------------
PORT=8000
DATA_PATH=/mnt/user/appdata/lanyard
IMAGE=ghcr.io/wolfej4/lanyard:latest
CONTAINER_NAME=lanyard
# Only Pangolin can reach the container port, so trusting any forwarder is fine.
# If the port is reachable from elsewhere, put Pangolin's IP here instead.
FORWARDED_ALLOW_IPS=*


# ==============================================================================
# Local development instead? Replace everything above with just this, and run
# `uvicorn app.main:app --reload` (no Docker, SQLite, simulated payments,
# sign-in links printed to the terminal):
#
# SECRET_KEY=dev
# BASE_URL=http://localhost:8000
# DEV_FAKE_PAYMENTS=true
# ADMIN_EMAILS=you@example.com
# OPERATOR_NAME=Local Dev
# CONTACT_EMAIL=you@example.com
# ==============================================================================
